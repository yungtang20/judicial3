# Root ignores (repo has no root .gitignore; legal-case-web/.gitignore covers only that subdir)
.omo/
.pytest_cache/
__pycache__/
*.pyc
*.py[cod]
.wip-*.patch
*.orig
*.bak
*.bak_orig
*.rej
_tmp_*.py
.DS_Store
*.log
.env*
!.env.example
node_modules/
build/
dist/
coverage/
# Local reference material (untracked, keep out of git noise; force-add if ever needed)
偵查犯罪手冊(114.12.12版本).pdf
# 本機備份與草稿（可重建；需要時用 git add -f 收入）
新套表_備份*.xlsm
# 個人瀏覽器截圖（不進版控，避免誤提交個資）
例子/
# 已淘汰原型的本機秘密仍保留在原路徑，不隨原始碼封存
legal-case-web/web_app/.env.local
legal-case-web/app_prototype/.env
# 本機驗證探針輸出（正式回歸測試與 tools/ 腳本仍納入版控）
legal-case-web/_smoke_cands.json
legal-case-web/_smoke_flow.py
# PGlite runtime state is machine-local and must never be committed.
database/pglite_store/
# Local verification artifacts
._verify_render_*/
