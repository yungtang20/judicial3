# Copy to `.env` for local development only. Never commit a real `.env`.
# Production values must be injected by the platform secret manager.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL="http://127.0.0.1:3000"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development defaults to PGlite (a file-backed PostgreSQL-compatible
# store). Production accepts ONLY `postgres` and requires DATABASE_URL.
JUDICIAL3_DATABASE_ENGINE=pglite
JUDICIAL3_DATABASE_PATH=""
DATABASE_URL=

# Used only by `npm run db:migrate`; when empty the tool falls back to
# DATABASE_URL.
MIGRATION_DATABASE_URL=

# Optional PostgreSQL pool/timeouts. Defaults shown.
# JUDICIAL3_DB_CONNECT_TIMEOUT_MS=5000
# JUDICIAL3_DB_POOL_MAX=10
# JUDICIAL3_DB_STATEMENT_TIMEOUT_MS=15000
# JUDICIAL3_DB_QUERY_TIMEOUT_MS=20000
# JUDICIAL3_DB_SSL=false

# Local test seeding. MUST be false in production.
JUDICIAL3_LOAD_TEST_SEED=false

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Exact browser origin in production, e.g. https://judicial3.example.gov.tw
# Must be https and must not have a trailing slash.
JUDICIAL3_PUBLIC_ORIGIN=

# The loopback-only developer bridge is disabled by default and is always
# rejected when NODE_ENV=production.
JUDICIAL3_ALLOW_DEV_SESSION=false
JUDICIAL3_DEV_USER_ID=
# Required only when the local developer bridge is enabled. Generate a long
# random value; never reuse it in production.
JUDICIAL3_SESSION_SECRET=

# ---------------------------------------------------------------------------
# External AI (fail-closed)
# ---------------------------------------------------------------------------
# External AI stays disabled unless BOTH the gate and a key/model are present.
# Do not send real case data to an external model without separate approval.
JUDICIAL3_ALLOW_EXTERNAL_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=
