# Required for authenticated API routes. Generate and inject a long random value;
# never commit the real secret.
JUDICIAL3_SESSION_SECRET="replace-with-a-long-random-secret"

# Local development only. Production always rejects the dev-session route.
JUDICIAL3_ALLOW_DEV_SESSION="false"

# External AI is fail-closed and disabled unless this explicit gate and a key
# are both configured. Do not send real case data without separate approval.
JUDICIAL3_ALLOW_EXTERNAL_AI="false"
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Optional local PGlite path. This is not a PostgreSQL DATABASE_URL.
JUDICIAL3_DATABASE_PATH=""

APP_URL="http://127.0.0.1:3000"
